[Unit]
Description=War Thunder UID Guard administrator upload service
After=network.target

[Service]
Type=simple
User=wtuidguard
Group=wtuidguard
WorkingDirectory=/opt/wtuidguard
ExecStart=/usr/bin/python3 /opt/wtuidguard/admin_upload_server.py
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
UMask=0027

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=wtuidguard
StateDirectoryMode=0750
LogsDirectory=wtuidguard
LogsDirectoryMode=0750
ReadWritePaths=/srv/wtuidguard/www
ReadOnlyPaths=/etc/wtuidguard

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
